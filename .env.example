# ---- Frontend (Vite) ----
# URL base de la API (backend PHP). Déjalo relativo ("/api") si sirves el
# frontend y la API en el mismo dominio, o pon la URL completa de tu backend,
# p. ej. https://tu-dominio.com/api
VITE_API_BASE=/api

# ---- Backend (PHP) ----
# Estas NO son variables de Vite: configúralas en el entorno de tu servidor
# (Apache SetEnv, fpm pool, panel del hosting, etc.). Se listan aquí solo como
# referencia; el frontend no las lee.
#
# APP_ALLOWED_ORIGINS = https://tu-dominio.com,https://www.tu-dominio.com
# APP_DB_PATH         = /ruta/fuera/del/webroot/app_data/gym.db
# ADMIN_USERNAME       = tu_admin
# ADMIN_EMAIL          = admin@tu-dominio.com
# ADMIN_PASSWORD_SHA256 = <sha256 de tu contraseña de admin>

# Solo si la app vive en una subcarpeta (con barra final): VITE_BASE=/gym/
